# DevAssist Chatbot — environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env
# (it is git-ignored). This file contains PLACEHOLDERS ONLY.

# --- Groq Cloud API (backend only — never exposed to the frontend) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq chat model. Verified 2026-09-30: llama-3.3-70b-versatile was retired by
# Groq (HTTP 404, code=model_not_found); openai/gpt-oss-120b is the closest
# currently-supported chat model. See README "Design decisions".
GROQ_MODEL=openai/gpt-oss-120b

# --- Backend server ---
PORT=8000
# Allowed browser origin (CORS) — a single restricted origin, never "*".
# Local development: http://localhost:5173
# Remote testing via Ngrok: set to your frontend tunnel's public HTTPS URL,
# e.g. FRONTEND_ORIGIN=https://<your-frontend-tunnel>.ngrok-free.dev
FRONTEND_ORIGIN=http://localhost:5173

# --- Uploads ---
MAX_FILE_SIZE_MB=5

# --- RAG ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
# Hard bound (chars) on retrieved context sent to the LLM.
MAX_RAG_CONTEXT_CHARS=6000

# --- Behaviour ---
# true = stream a clearly-marked canned response instead of calling Groq.
# Also enabled automatically when GROQ_API_KEY is empty (local dev / tests).
MOCK_GROQ=false

# --- Frontend (Vite) ---
# Base URL of the FastAPI backend. The chat WebSocket URL is derived
# automatically (http:// -> ws://, https:// -> wss://).
# Local development: http://localhost:8000
# Remote testing via Ngrok: your backend tunnel's public HTTPS URL,
# e.g. VITE_API_URL=https://<your-backend-tunnel>.ngrok-free.dev
# VITE_API_URL=http://localhost:8000
