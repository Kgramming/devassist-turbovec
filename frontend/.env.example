# Base URL of the DevAssist FastAPI backend.
# The frontend never holds API keys — GROQ_API_KEY lives only in backend/.env.
#
# Local development (default): http://localhost:8000
#
# Remote testing via Ngrok: set this to your backend tunnel's public HTTPS
# URL, e.g. VITE_API_URL=https://<your-backend-tunnel>.ngrok-free.dev
# The chat WebSocket URL is derived automatically (https:// -> wss://).
# Never commit a file with a real tunnel URL — pass it at build/dev time.
VITE_API_URL=http://localhost:8000
